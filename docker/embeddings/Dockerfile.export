# Export ONNX reproductible des modèles d'embedding. Tourne à la demande
# (`docker compose run --rm rag-model-export …`), jamais en service permanent.
# Environnement séparé : optimum-onnx 0.1.0 exige transformers < 4.58, incompatible
# avec sentence-transformers 6 (vérifié le 30/09/2026).
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

# torch seul, depuis l'index CPU de PyTorch uniquement (jamais d'index supplémentaire :
# pip prendrait la version la plus haute de n'importe quel paquet sur l'un ou l'autre).
# --no-deps : ses dépendances viennent du verrou ci-dessous, vérifiées par empreinte.
RUN pip install --no-cache-dir --no-deps --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.14.1+cpu"

# Tout le reste depuis PyPI, versions et empreintes figées (verrou sans torch ni CUDA).
COPY docker/embeddings/requirements-export.txt /tmp/requirements-export.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-export.txt

COPY docker/embeddings/export_model.py /opt/export/export_model.py
ENTRYPOINT ["python", "/opt/export/export_model.py"]
