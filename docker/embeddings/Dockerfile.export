# Export ONNX reproductible des modèles d'embedding, lancé à la demande (service rag-model-export).
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

# torch seul depuis l'index CPU de PyTorch (jamais d'index mélangé), ses dépendances viennent du verrou suivant.
COPY docker/embeddings/requirements-torch.txt /tmp/requirements-torch.txt
RUN pip install --no-cache-dir --no-deps --require-hashes \
        --index-url https://download.pytorch.org/whl/cpu -r /tmp/requirements-torch.txt

# Tout le reste depuis PyPI, versions et empreintes figées.
COPY docker/embeddings/requirements-export.txt /tmp/requirements-export.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-export.txt

COPY docker/embeddings/export_model.py /opt/export/export_model.py
ENTRYPOINT ["python", "/opt/export/export_model.py"]
