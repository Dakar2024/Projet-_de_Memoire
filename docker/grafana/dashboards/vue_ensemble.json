      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - genomics_last_successful_run_timestamp) / 86400",
          "legendFormat": "{{dag}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
