      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
