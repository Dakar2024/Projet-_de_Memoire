      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "mappings": [],
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Runs en cours",
