# Image des tests d'intégration du RAG : l'image rag-api + pytest, vérifiés par empreinte.
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016
COPY docker/rag-api/requirements.lock /tmp/requirements.lock
COPY docker/rag-api/requirements-test.lock /tmp/requirements-test.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock -r /tmp/requirements-test.lock
