APP_NAME=Genomica
APP_ENV=development
DEBUG=false

# Port publié sur 127.0.0.1 par compose.yml (8000 est pris par Portainer)
API_PORT=8100

# CORS — liste JSON des origines autorisées
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL « apps » (POSTGRES_HOST est forcé à db dans compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=genomica
POSTGRES_PASSWORD=
POSTGRES_DB=genomica
DB_PORT=5433

# Auth — clé aléatoire d'au moins 32 octets : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Compte admin créé au démarrage
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# Mail — Resend en SMTP : port 465 en TLS implicite, utilisateur « resend », mot de passe = clé API
MAIL_SERVER=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_STARTTLS=false

# Redis (Huey, limitation de débit) — forcé à redis://redis:6379/0 dans compose.yml
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:3000

# IP réelle pour les limites de débit : true seulement si l'API n'est joignable que par le serveur
# du frontend (port publié sur 127.0.0.1, comme dans compose.yml)
TRUST_FORWARDED_FOR=true
