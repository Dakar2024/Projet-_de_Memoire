# Faux backend en mémoire (comptes de démonstration, chiffres du gold figés au 2026-10-22).
# Mettre à false dès que le backend Litestar (apps/backend) tourne.
VITE_USE_MOCKS=true

# URL interne du backend, utilisée par les server functions (SSR, garde d'accès).
API_INTERNAL_URL=http://localhost:8000

# Cible du proxy de développement : le navigateur appelle /api/* sur la même origine.
API_PROXY_TARGET=http://localhost:8000
