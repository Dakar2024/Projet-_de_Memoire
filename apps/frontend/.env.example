# Faux backend en mémoire (comptes de démonstration, chiffres du gold figés au 2026-10-22).
# Mettre à false dès que le backend Litestar (apps/backend) tourne.
VITE_USE_MOCKS=true

# URL interne du backend, utilisée par les server functions (SSR, garde d'accès).
API_INTERNAL_URL=http://localhost:8100

# Cible du proxy de développement : le navigateur appelle /api/* sur la même origine.
API_PROXY_TARGET=http://localhost:8100

# Bouton « Continuer avec Microsoft » (Entra ID) au-dessus des formulaires de connexion.
# Avec le faux backend, un clic explique qu'il n'est pas encore branché.
VITE_AUTH_MICROSOFT=true

# Sélecteur de panel dans l'assistant. Laisser à false tant que le RAG n'accepte pas le paramètre
# `panels` (MODELISATION_BACKEND.md § 4.2) : sinon l'interface promettrait un filtre inexistant.
VITE_ASSISTANT_PANEL_FILTER=false
