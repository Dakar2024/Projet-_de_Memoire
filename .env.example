# Modèle à copier en .env, jamais de vraie valeur ici ; secrets : python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# NCBI E-utilities (clé API facultative : la laisser vide plutôt que factice)
NCBI_EMAIL=
NCBI_API_KEY=

# Airflow : UID de l'hôte (id -u), base de métadonnées, secret partagé et compte admin
AIRFLOW_UID=
POSTGRES_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_PASSWORD=

# MinIO : compte root, ports hôte et compte de service d'Airflow
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_AIRFLOW_USER=airflow
MINIO_AIRFLOW_PASSWORD=

# Alertes e-mail sur échec via Resend (ALERT_EMAIL vide : aucun envoi)
# Clé « Sending access » limitée au domaine d'envoi ; ALERT_FROM sur ce domaine vérifié
RESEND_API_KEY=
ALERT_FROM=
# Destinataires séparés par des virgules
ALERT_EMAIL=

# RAG : modèle d'embedding servi, clé du service d'embedding et comptes de la base vectorielle
RAG_EMBEDDING_MODEL=pubmedbert-base-embeddings
RAG_EMBEDDINGS_API_KEY=
RAG_OWNER_PASSWORD=
RAG_INDEXER_PASSWORD=
RAG_READER_PASSWORD=

# LLM : clés OpenRouter (mesure officielle) et Groq (essai)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# API du RAG : clé X-API-Key (32 caractères au moins) et port local
RAG_API_KEY=
RAG_API_PORT=8090
