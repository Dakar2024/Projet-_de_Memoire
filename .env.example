# Modèle de configuration. Copier en .env (gitignoré) et y saisir vos vraies valeurs.
# Ne jamais mettre de vraies valeurs dans CE fichier : il est suivi par git.

# Adresse email (obligatoire, exigée par NCBI E-utilities).
NCBI_EMAIL=

# Clé API NCBI (recommandée : 10 req/s au lieu de 3).
# À obtenir sur https://account.ncbi.nlm.nih.gov/settings/
# Laisser VIDE si vous n'en avez pas : une valeur factice serait transmise à NCBI et
# ferait passer le limiteur en cadence rapide, provoquant des erreurs en plein run.
NCBI_API_KEY=

# --- Stack Docker (Airflow 3 + MinIO), utilisée par `docker compose --env-file .env` ---
# uid sous lequel tournent les conteneurs Airflow : sortie de `id -u` sur l'hôte. Il
# doit pouvoir écrire dans data/ du dépôt monté (le défaut 50000 de l'image ne le peut pas).
AIRFLOW_UID=
POSTGRES_PASSWORD=
# Identifiants administrateur de MinIO : ils amorcent les buckets et ouvrent la
# console. Aucune tâche du pipeline ne les utilise.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Compte de service d'Airflow, restreint aux quatre buckets du médaillon par la
# politique `airflow-lake`. Générer un mot de passe long, par exemple avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_AIRFLOW_USER=airflow
MINIO_AIRFLOW_PASSWORD=

# Ports hôte de MinIO. Changer si 9000/9001 sont déjà occupés (ex. 9010 et 9011).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Secret partagé entre composants Airflow. Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
