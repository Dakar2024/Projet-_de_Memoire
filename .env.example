# Modèle de configuration. Copier en .env (gitignoré) et y saisir vos vraies valeurs.
# Ne jamais mettre de vraies valeurs dans CE fichier : il est suivi par git.

# Adresse email (obligatoire, exigée par NCBI E-utilities).
NCBI_EMAIL=

# Clé API NCBI (recommandée : 10 req/s au lieu de 3).
# À obtenir sur https://account.ncbi.nlm.nih.gov/settings/
# Laisser VIDE si vous n'en avez pas : une valeur factice serait transmise à NCBI et
# ferait passer le limiteur en cadence rapide, provoquant des erreurs en plein run.
NCBI_API_KEY=

# --- Stack Docker (Airflow 3 + MinIO), utilisée par `docker compose --env-file .env` ---
# uid sous lequel tournent les conteneurs Airflow : sortie de `id -u` sur l'hôte. Il
# doit pouvoir écrire dans data/ du dépôt monté (le défaut 50000 de l'image ne le peut pas).
AIRFLOW_UID=
POSTGRES_PASSWORD=
# Identifiants administrateur de MinIO : ils amorcent les buckets et ouvrent la
# console. Aucune tâche du pipeline ne les utilise.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Compte de service d'Airflow, restreint aux quatre buckets du médaillon par la
# politique `airflow-lake`. Générer un mot de passe long, par exemple avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_AIRFLOW_USER=airflow
MINIO_AIRFLOW_PASSWORD=

# Ports hôte de MinIO. Changer si 9000/9001 sont déjà occupés (ex. 9010 et 9011).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Secret partagé entre composants Airflow. Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=

# Mot de passe du compte "admin" de l'interface Airflow (SimpleAuthManager). Sans elle,
# Airflow en génère un lui-même à la première connexion, visible seulement dans les logs
# de l'apiserver. Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_ADMIN_PASSWORD=

# --- Alertes sur échec d'un run ---
# Serveur d'envoi. Laisser vide tant qu'aucun n'est choisi : les tâches échouent
# normalement, seul le mail ne part pas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur des alertes.
ALERT_FROM=
# Destinataire(s), séparés par des virgules.
ALERT_EMAIL=

# --- RAG (sous-projet E1) ---
# Dossier du modèle servi, sous data/models/ (export : RAG/README.md).
RAG_EMBEDDING_MODEL=pubmedbert-base-embeddings
# Clé d'API du service d'embedding. Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_EMBEDDINGS_API_KEY=
# Mots de passe des trois comptes de la base vectorielle (même commande) :
# rag_owner (amorçage), rag_indexer (Airflow), rag_reader (API, lecture seule).
RAG_OWNER_PASSWORD=
RAG_INDEXER_PASSWORD=
RAG_READER_PASSWORD=

# Clé OpenRouter (analyse de la question, E2a). https://openrouter.ai/settings/keys
# Facultative pour le pipeline ; la recherche refuse de tourner sans elle.
OPENROUTER_API_KEY=
