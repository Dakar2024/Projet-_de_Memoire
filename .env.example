# Modèle de configuration. Copier en .env (gitignoré) et y saisir vos vraies valeurs.
# Ne jamais mettre de vraies valeurs dans CE fichier : il est suivi par git.

# Adresse email (obligatoire, exigée par NCBI E-utilities).
NCBI_EMAIL=

# Clé API NCBI (recommandée : 10 req/s au lieu de 3).
# À obtenir sur https://account.ncbi.nlm.nih.gov/settings/
# Laisser VIDE si vous n'en avez pas : une valeur factice serait transmise à NCBI et
# ferait passer le limiteur en cadence rapide, provoquant des erreurs en plein run.
NCBI_API_KEY=
